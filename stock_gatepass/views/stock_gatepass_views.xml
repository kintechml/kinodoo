<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Gate Pass Type Form View -->
        <record id="view_stock_gatepass_type_form" model="ir.ui.view">
            <field name="name">stock.gatepass.type.form</field>
            <field name="model">stock.gatepass.type</field>
            <field name="arch" type="xml">
                <form string="Gate Pass Type">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="e.g. Customer Material Return"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="is_returnable"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="note" placeholder="Add a description here..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Gate Pass Type Tree View -->
        <record id="view_stock_gatepass_type_tree" model="ir.ui.view">
            <field name="name">stock.gatepass.type.tree</field>
            <field name="model">stock.gatepass.type</field>
            <field name="arch" type="xml">
                <tree string="Gate Pass Types">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="is_returnable"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Gate Pass Form View -->
        <record id="view_stock_gatepass_form" model="ir.ui.view">
            <field name="name">stock.gatepass.form</field>
            <field name="model">stock.gatepass</field>
            <field name="arch" type="xml">
                <form string="Gate Pass">
                    <header>
                        <!-- Use conditional invisibility based on state instead of states attribute -->
                        <field name="state" invisible="1"/>
                        <field name="is_returnable" invisible="1"/>
                        <field name="returned" invisible="1"/>

                        <button name="action_submit" invisible="state != 'draft'" string="Submit" type="object" class="oe_highlight"/>
                        <button name="action_confirm" invisible="state != 'submit'" string="Confirm" type="object" class="oe_highlight" groups="stock_gatepass.group_gatepass_manager"/>
                        <button name="action_create_return" invisible="state != 'confirmed' or not is_returnable" string="Create Return" type="object" class="oe_highlight"/>
                        <button name="action_done" invisible="state != 'confirmed' or (is_returnable and not returned)" string="Mark as Done" type="object" class="oe_highlight"/>
                        <button name="action_cancel" invisible="state not in ('draft', 'submit', 'confirmed')" string="Cancel" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submit,confirmed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="action_view_pickings" type="object" icon="fa-truck">
                                <field name="picking_count" widget="statinfo" string="Pickings"/>
                            </button>
                            <button class="oe_stat_button" name="action_view_returns" type="object" icon="fa-undo" invisible="not is_returnable">
                                <field name="return_count" widget="statinfo" string="Returns"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="gatepass_type_id" options="{'no_create': True}"/>
                                <field name="is_returnable" invisible="1"/>
                                <field name="partner_id"/>
                                <field name="warehouse_id"/>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="issue_date"/>
                                <!-- required is handled via model constraints -->
                                <field name="expected_return_date" invisible="not is_returnable"/>
                                <field name="actual_return_date" readonly="1" invisible="not actual_return_date"/>
                                <field name="returned" invisible="1"/>
                                <field name="approved_by" invisible="not approved_by"/>
                                <field name="approved_date" invisible="not approved_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Products">
                                <!-- Company ID needed for product_id domain -->
                                <field name="company_id" invisible="1"/>
                                <field name="line_ids" widget="one2many_list" mode="tree,kanban">
                                    <tree string="Products" editable="bottom">
                                        <field name="product_id" context="{'default_company_id': parent.company_id}"/>
                                        <field name="product_uom_qty"/>
                                        <field name="product_uom" groups="uom.group_uom"/>
                                        <field name="name" optional="hide"/>
                                        <field name="returned_qty" readonly="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="product_uom_category_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="note" placeholder="Add any notes or additional info here..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Gate Pass Tree View -->
        <record id="view_stock_gatepass_tree" model="ir.ui.view">
            <field name="name">stock.gatepass.tree</field>
            <field name="model">stock.gatepass</field>
            <field name="arch" type="xml">
                <tree string="Gate Passes" decoration-warning="state == 'submit'" decoration-info="state == 'confirmed'" decoration-muted="state == 'cancel'" decoration-danger="state == 'expired'" decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="gatepass_type_id"/>
                    <field name="partner_id"/>
                    <field name="issue_date"/>
                    <field name="expected_return_date"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <!-- Gate Pass Search View -->
        <record id="view_stock_gatepass_search" model="ir.ui.view">
            <field name="name">stock.gatepass.search</field>
            <field name="model">stock.gatepass</field>
            <field name="arch" type="xml">
                <search string="Gate Passes">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="gatepass_type_id"/>
                    <field name="approved_by"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Submitted" name="submit" domain="[('state','=','submit')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                    <filter string="Done" name="done" domain="[('state','=','done')]"/>
                    <filter string="Expired" name="expired" domain="[('state','=','expired')]"/>
                    <filter string="Cancelled" name="cancel" domain="[('state','=','cancel')]"/>
                    <separator/>
                    <filter string="Returnable" name="returnable" domain="[('is_returnable','=',True)]"/>
                    <filter string="Returned" name="returned" domain="[('returned','=',True)]"/>
                    <filter string="Pending Return" name="pending_return" domain="[('is_returnable','=',True), ('returned','=',False), ('state','=','confirmed')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Partner" name="partner_id" context="{'group_by':'partner_id'}"/>
                        <filter string="Type" name="gatepass_type_id" context="{'group_by':'gatepass_type_id'}"/>
                        <filter string="Status" name="state" context="{'group_by':'state'}"/>
                        <filter string="Issue Date" name="issue_date" context="{'group_by':'issue_date'}"/>
                        <filter string="Return Date" name="expected_return_date" context="{'group_by':'expected_return_date'}"/>
                        <filter string="Company" name="company_id" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Gate Pass Calendar View -->
        <record id="view_stock_gatepass_calendar" model="ir.ui.view">
            <field name="name">stock.gatepass.calendar</field>
            <field name="model">stock.gatepass</field>
            <field name="arch" type="xml">
                <calendar string="Gate Passes" date_start="issue_date" color="gatepass_type_id">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="gatepass_type_id"/>
                </calendar>
            </field>
        </record>

        <!-- Gate Pass Pivot View -->
        <record id="view_stock_gatepass_pivot" model="ir.ui.view">
            <field name="name">stock.gatepass.pivot</field>
            <field name="model">stock.gatepass</field>
            <field name="arch" type="xml">
                <pivot string="Gate Pass Analysis">
                    <field name="issue_date" type="row"/>
                    <field name="gatepass_type_id" type="col"/>
                    <field name="partner_id" type="row"/>
                </pivot>
            </field>
        </record>

        <!-- Gate Pass Actions -->
        <record id="action_stock_gatepass" model="ir.actions.act_window">
            <field name="name">Gate Passes</field>
            <field name="res_model">stock.gatepass</field>
            <field name="view_mode">tree,form,calendar,pivot</field>
            <field name="search_view_id" ref="view_stock_gatepass_search"/>
            <field name="context">{'search_default_draft': 1, 'search_default_submit': 1, 'search_default_confirmed': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new gate pass
                </p>
                <p>
                    Create gate passes for incoming and outgoing materials.
                </p>
            </field>
        </record>

        <record id="action_stock_gatepass_type" model="ir.actions.act_window">
            <field name="name">Gate Pass Types</field>
            <field name="res_model">stock.gatepass.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new gate pass type
                </p>
                <p>
                    Define different types of gate passes with specific behavior.
                </p>
            </field>
        </record>

        <!-- Menuitem -->
        <menuitem id="menu_stock_gatepass_root" name="Gate Passes" parent="stock.menu_stock_root" sequence="7"/>
        <menuitem id="menu_stock_gatepass" name="Gate Passes" action="action_stock_gatepass" parent="menu_stock_gatepass_root" sequence="1"/>
        <menuitem id="menu_stock_gatepass_type" name="Gate Pass Types" action="action_stock_gatepass_type" parent="menu_stock_gatepass_root" sequence="2"/>
    </data>
</odoo>
