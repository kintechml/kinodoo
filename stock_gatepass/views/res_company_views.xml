<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Gate Pass settings to company form -->
        <record id="view_company_form_gatepass" model="ir.ui.view">
            <field name="name">res.company.form.gatepass</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Gate Pass Settings" name="gatepass_settings">
                        <group>
                            <group string="Gate Pass Configuration">
                                <field name="gatepass_validity_days"/>
                                <field name="gatepass_auto_expire"/>
                                <field name="gatepass_approval_required"/>
                                <field name="gatepass_default_return_location_id" 
                                       domain="[('usage', '=', 'internal'), ('company_id', '=', id)]"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
