<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Gate Pass Security Groups -->
        <record id="group_gatepass_user" model="res.groups">
            <field name="name">Gate Pass User</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_gatepass_manager" model="res.groups">
            <field name="name">Gate Pass Manager</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('group_gatepass_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Multi-company Rules -->
        <record id="gatepass_comp_rule" model="ir.rule">
            <field name="name">Gate Pass Multi-Company</field>
            <field name="model_id" ref="model_stock_gatepass"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
        </record>

        <record id="gatepass_type_comp_rule" model="ir.rule">
            <field name="name">Gate Pass Type Multi-Company</field>
            <field name="model_id" ref="model_stock_gatepass_type"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
        </record>
    </data>
</odoo>
